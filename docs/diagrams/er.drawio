        <mxCell id="r5" value="父子分类（parent_id → id）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=1;html=1;strokeColor=#22c55e;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="category" target="category">
          <mxGeometry relative="1" as="geometry">
