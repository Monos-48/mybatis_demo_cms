<mxfile host="app.diagrams.net" agent="Atlas CMS" version="24.7.17" type="device">
  <diagram id="cms-er" name="数据库 E-R 图">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Atlas CMS 数据库 E-R 图（6 张业务表 + 2 张关联表）" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="PK = 主键　FK = 外键　UK = 唯一键　　RBAC 蓝／内容绿／审计橙" style="text;html=1;fontSize=12;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="700" height="25" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;sys_user 用户&lt;/b&gt;&lt;br&gt;────────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;UK  username : VARCHAR(50)&lt;br&gt;     password : VARCHAR(100)&lt;br&gt;     nickname : VARCHAR(50)&lt;br&gt;     email : VARCHAR(100)&lt;br&gt;     status : TINYINT&lt;br&gt;     last_login_time : DATETIME&lt;br&gt;     create_time : DATETIME&lt;br&gt;     update_time : DATETIME&lt;br&gt;     deleted : TINYINT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="230" height="250" as="geometry" />
        </mxCell>
        <mxCell id="user_role" value="&lt;b&gt;sys_user_role&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;FK  user_id : BIGINT&lt;br&gt;FK  role_id : BIGINT&lt;br&gt;UK  (user_id, role_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="340" y="160" width="190" height="150" as="geometry" />
        </mxCell>
        <mxCell id="role" value="&lt;b&gt;sys_role 角色&lt;/b&gt;&lt;br&gt;────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;UK  role_code : VARCHAR(50)&lt;br&gt;     role_name : VARCHAR(50)&lt;br&gt;     status : TINYINT&lt;br&gt;     remark : VARCHAR(200)&lt;br&gt;     create_time : DATETIME&lt;br&gt;     update_time : DATETIME&lt;br&gt;     deleted : TINYINT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="600" y="125" width="220" height="220" as="geometry" />
        </mxCell>
        <mxCell id="role_perm" value="&lt;b&gt;sys_role_permission&lt;/b&gt;&lt;br&gt;──────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;FK  role_id : BIGINT&lt;br&gt;FK  permission_id : BIGINT&lt;br&gt;UK  (role_id, permission_id)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="880" y="160" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="permission" value="&lt;b&gt;sys_permission 权限&lt;/b&gt;&lt;br&gt;──────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;UK  perm_code : VARCHAR(100)&lt;br&gt;     perm_name : VARCHAR(100)&lt;br&gt;     uri : VARCHAR(200)&lt;br&gt;     method : VARCHAR(10)&lt;br&gt;     create_time : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="1150" y="125" width="250" height="210" as="geometry" />
        </mxCell>

        <mxCell id="category" value="&lt;b&gt;cms_category 分类&lt;/b&gt;&lt;br&gt;──────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;     name : VARCHAR(50)&lt;br&gt;     parent_id : BIGINT (0=顶级)&lt;br&gt;     sort : INT&lt;br&gt;     status : TINYINT&lt;br&gt;     description : VARCHAR(200)&lt;br&gt;     create_time : DATETIME&lt;br&gt;     update_time : DATETIME&lt;br&gt;     create_by / update_by : BIGINT&lt;br&gt;     deleted : TINYINT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=11;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="260" height="280" as="geometry" />
        </mxCell>
        <mxCell id="article" value="&lt;b&gt;cms_article 文章&lt;/b&gt;&lt;br&gt;──────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;     title : VARCHAR(100)&lt;br&gt;     summary : VARCHAR(500)&lt;br&gt;     content : LONGTEXT&lt;br&gt;FK  category_id : BIGINT&lt;br&gt;FK  author_id : BIGINT&lt;br&gt;     status : TINYINT (0–5)&lt;br&gt;     audit_remark : VARCHAR(500)&lt;br&gt;FK  audit_by : BIGINT&lt;br&gt;     audit_time : DATETIME&lt;br&gt;     publish_time : DATETIME&lt;br&gt;     view_count : INT&lt;br&gt;     version : INT (乐观锁)&lt;br&gt;     create_time / update_time&lt;br&gt;     create_by / update_by : BIGINT&lt;br&gt;     deleted : TINYINT" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=11;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="300" height="360" as="geometry" />
        </mxCell>
        <mxCell id="oper_log" value="&lt;b&gt;sys_oper_log 操作日志&lt;/b&gt;&lt;br&gt;────────────────────&lt;br&gt;PK  id : BIGINT&lt;br&gt;FK  user_id : BIGINT (SET NULL)&lt;br&gt;     username : VARCHAR(50)&lt;br&gt;     module : VARCHAR(50)&lt;br&gt;     operation : VARCHAR(100)&lt;br&gt;     method : VARCHAR(200)&lt;br&gt;     request_uri / request_method&lt;br&gt;     params : VARCHAR(2000) 脱敏&lt;br&gt;     ip : VARCHAR(50)&lt;br&gt;     cost_time : BIGINT&lt;br&gt;     success : TINYINT&lt;br&gt;     error_msg : VARCHAR(1000)&lt;br&gt;     create_time : DATETIME" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff7ed;strokeColor=#f97316;fontSize=11;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="990" y="400" width="300" height="320" as="geometry" />
        </mxCell>

