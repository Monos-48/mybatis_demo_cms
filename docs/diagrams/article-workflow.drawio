        </mxCell>
        <mxCell id="subtitle" value="状态码：0 草稿 · 1 待审核 · 2 审核通过 · 3 已驳回 · 4 已发布 · 5 已下架" style="text;html=1;fontSize=13;fontColor=#475569;align=left;" vertex="1" parent="1">
