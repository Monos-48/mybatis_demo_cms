        <mxCell id="t2" value="新建并直接提交&lt;br&gt;submitForReview=true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;curved=1;" edge="1" parent="1" source="start" target="pending">
          <mxGeometry relative="1" as="geometry">
