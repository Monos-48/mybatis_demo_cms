        <mxCell id="deleted" value="逻辑删除&lt;br&gt;deleted = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="930" y="430" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="新建&lt;br&gt;submitForReview=false" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="draft">
          <mxGeometry relative="1" as="geometry" />
