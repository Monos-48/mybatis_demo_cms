              <mxPoint x="1255" y="340" />
              <mxPoint x="1005" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t10" value="作者保存修改&lt;br&gt;仍保持“已驳回”（不自动回到草稿）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ef4444;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#7f1d1d;labelBackgroundColor=#ffffff;curved=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="rejected" target="rejected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="422" />
              <mxPoint x="650" y="468" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t11" value="删除：作者仅限草稿/驳回；EDITOR/ADMIN 可删任意状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#475569;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="published" target="deleted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="role-note" value="&lt;b&gt;角色边界&lt;/b&gt;&lt;br&gt;AUTHOR：新建、编辑自己的草稿/驳回稿、提交、删除自己的草稿/驳回稿&lt;br&gt;EDITOR：文章全流程 + 分类管理 + 审核/发布/下架&lt;br&gt;ADMIN：全部权限，含用户、角色、日志&lt;br&gt;VIEWER：只读&lt;br&gt;&lt;br&gt;所有更新带 version 乐观锁；状态不合法返回 409，权限不足返回 403。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;fontSize=12;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="555" width="720" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tip" value="提示：驳回后再次“提交审核”可直接进入待审核；修改并保存但未提交时，状态仍为“已驳回”。" style="text;html=1;fontSize=12;fontColor=#475569;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="520" height="60" as="geometry" />
