        <mxCell id="offline" value="&lt;b&gt;5 已下架&lt;/b&gt;&lt;br&gt;OFFLINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=15;fontColor=#334155;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="1180" y="185" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="&lt;b&gt;3 已驳回&lt;/b&gt;&lt;br&gt;REJECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontSize=15;fontColor=#7f1d1d;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="430" y="400" width="150" height="90" as="geometry" />
